# Environment variables (SECURITY: NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
Backend/.env
Frontend/.env

# Python Virtual Environments
.venv/
venv/
ENV/
env/
Backend/.venv/
Backend/venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# Node & Frontend Build Artifacts
node_modules/
Frontend/node_modules/
.output/
Frontend/.output/
.wrangler/
Frontend/.wrangler/
dist/
build/
.nitro/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
~$*
*.tmp

# Qdrant local storage (if any)
qdrant_storage/
Backend/qdrant_storage/

# Runtime databases. These are rebuilt on startup and written to while the app runs,
# so committing them makes every demo dirty the working tree — and a stale committed
# copy makes the seeder skip seeding, because it sees employees already there.
Backend/data/omni_hr.db
Backend/data/conversation_checkpoints.sqlite
Backend/data/conversation_checkpoints.sqlite-wal
Backend/data/conversation_checkpoints.sqlite-shm
