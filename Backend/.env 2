# HCS-01 local config (gitignored — safe for secrets)

# ── REQUIRED: paste your OpenAI key here ─────────────────────────
OPENAI_API_KEY=

# ── Models ───────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
LLM_MODEL=gpt-4o

# ── Qdrant: in-memory so no Docker is needed ─────────────────────
QDRANT_IN_MEMORY=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hcs01_policies

# ── FastAPI ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── RAG ──────────────────────────────────────────────────────────
RAG_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
