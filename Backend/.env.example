# ─────────────────────────────────────────────────────────────────
#  HCS-01 Environment Configuration
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Embedding & LLM Model ─────────────────────────────────────────
# Options: text-embedding-3-large | text-embedding-3-small | BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# Options: gpt-4o | gpt-4o-mini | gpt-4-turbo
LLM_MODEL=gpt-4o

# ── Qdrant ───────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hcs01_policies
# Set to "true" to use in-memory Qdrant (no Docker needed)
QDRANT_IN_MEMORY=false

# ── FastAPI ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── RAG Settings ─────────────────────────────────────────────────
RAG_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
