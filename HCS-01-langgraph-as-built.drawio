        <mxCell id="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="1860" y="486" as="sourcePoint"/><mxPoint x="1860" y="520" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="t4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="1860" y="632" as="sourcePoint"/><mxPoint x="1860" y="666" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p2title" value="&lt;b&gt;HCS-01 — Dalīl&lt;/b&gt;&lt;br/&gt;everything the graph leans on" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#16283A;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="600" height="70" as="geometry"/></mxCell>
