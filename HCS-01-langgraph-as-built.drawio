        <mxCell id="title" value="HCS-01 Policy &amp; Leave Concierge — LangGraph as built" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17233F;fontSize=26;fontStyle=1;" vertex="1" parent="1">
