        <mxCell id="e23" value="AWAITING_CONFIRMATION" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="handle_leave_application" target="compose_leave_confirmation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="declined / no dates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63B62;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="handle_leave_application" target="prepare_action_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A76500;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="request_leave_dates" target="wait_for_leave_dates"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="resume with dates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A76500;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wait_for_leave_dates" target="handle_leave_application"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A76500;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="compose_leave_confirmation" target="wait_for_leave_confirmation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="resume with decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A76500;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wait_for_leave_confirmation" target="submit_leave_application"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="submit_leave_application" target="prepare_action_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="run_action" target="prepare_action_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="generate_greeting" target="prepare_action_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="generate_document_upload_prompt" target="prepare_action_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="normalise validation contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#207A56;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prepare_action_answer" target="validate_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#207A56;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validate_answer" target="finalize_verified_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B33A3A;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validate_answer" target="build_safe_fallback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="finalize_verified_answer" target="record_conversation_turn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="build_safe_fallback" target="record_conversation_turn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="checkpoint final state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="record_conversation_turn" target="__end__"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="internals" name="02 - Tools, State and Boundaries">
    <mxGraphModel dx="3200" dy="2050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="p2_0"/><mxCell id="p2_1" parent="p2_0"/>
        <mxCell id="p2_title" value="As-Built Internals — Action Dispatch, Tool Layer, HCS-11 and Checkpoint State" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17233F;fontSize=30;fontStyle=1;" vertex="1" parent="p2_1"><mxGeometry x="50" y="20" width="3050" height="44" as="geometry"/></mxCell>
        <mxCell id="p2_subtitle" value="Graph nodes are shown in blue/pink; dashed components are ordinary Python or external systems. This page documents actual call paths and the controls that exist today." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5A6E;fontSize=15;" vertex="1" parent="p2_1"><mxGeometry x="50" y="68" width="3050" height="34" as="geometry"/></mxCell>

        <mxCell id="p2_actions_title" value="1  ACTION DISPATCH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#17233F;strokeColor=#17233F;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="p2_1"><mxGeometry x="70" y="135" width="1450" height="52" as="geometry"/></mxCell>
        <mxCell id="p2_understand" value="&lt;b&gt;understand_query&lt;/b&gt;&lt;br&gt;one QuestionIntent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0EAF9;strokeColor=#6B4BA3;strokeWidth=3;fontColor=#17233F;fontSize=14;" vertex="1" parent="p2_1"><mxGeometry x="100" y="240" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="p2_decide" value="&lt;b&gt;decide_after_understanding&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=3;fontColor=#17233F;fontSize=13;fontStyle=1;" vertex="1" parent="p2_1"><mxGeometry x="470" y="215" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p2_apply" value="&lt;b&gt;APPLY_LEAVE graph subflow&lt;/b&gt;&lt;br&gt;extract → policy check → date/confirm interrupts&lt;br&gt;→ re-check → run_tool apply_for_leave" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAE9F0;strokeColor=#A63B62;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="860" y="215" width="610" height="105" as="geometry"/></mxCell>
        <mxCell id="p2_run" value="&lt;b&gt;run_action graph node&lt;/b&gt;&lt;br&gt;ACTION_FOR_INTENT maps to handler functions&lt;br&gt;&lt;i&gt;not directly to TOOLS; not a ToolNode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAE9F0;strokeColor=#A63B62;strokeWidth=4;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="100" y="430" width="410" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_map" value="&lt;b&gt;ACTION_FOR_INTENT — handler registry&lt;/b&gt;&lt;br&gt;cancel → handle_leave_cancellation&lt;br&gt;status → handle_leave_status&lt;br&gt;approve/reject → handle_manager_approval&lt;br&gt;school intents absent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A63B62;strokeWidth=2;dashed=1;fontColor=#17233F;fontSize=13;align=left;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="580" y="415" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="p2_handlers" value="&lt;b&gt;Handler functions&lt;/b&gt;&lt;br&gt;Own regex parsing, scoped lookups, authorization decisions,&lt;br&gt;database/service reads, final wording and action_payload shape.&lt;br&gt;&lt;br&gt;handle_leave_status performs its main reads directly.&lt;br&gt;handle_manager_approval reads pending approvals directly.&lt;br&gt;Mutations generally use run_tool()." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=2;dashed=1;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="1070" y="390" width="400" height="200" as="geometry"/></mxCell>

        <mxCell id="p2_tools_title" value="2  CUSTOM TOOL LAYER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#17233F;strokeColor=#17233F;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="p2_1"><mxGeometry x="70" y="680" width="1450" height="52" as="geometry"/></mxCell>
        <mxCell id="p2_dispatch" value="&lt;b&gt;run_tool(name, authorised_to_write=False, **args)&lt;/b&gt;&lt;br&gt;Registry lookup → required argument presence check → mutation gate&lt;br&gt;→ call service → catch exceptions → ToolOutcome&lt;br&gt;&lt;br&gt;Fail-closed codes: unknown_tool • missing_arguments • not_authorised&lt;br&gt;the_action_failed • declined" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E7F4EC;strokeColor=#207A56;strokeWidth=4;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="100" y="785" width="650" height="190" as="geometry"/></mxCell>
        <mxCell id="p2_reads" value="&lt;b&gt;TOOLS — reads&lt;/b&gt;&lt;br&gt;check_leave_status(employee_id)&lt;br&gt;list_pending_approvals(manager_id)&lt;br&gt;get_education_entitlement(employee_id)&lt;br&gt;check_leave_against_policy(employee_id, draft)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#207A56;strokeWidth=2;dashed=1;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="820" y="775" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="p2_writes" value="&lt;b&gt;TOOLS — writes&lt;/b&gt;&lt;br&gt;apply_for_leave(employee_id, validation)&lt;br&gt;cancel_leave(employee_id, request_id)&lt;br&gt;approve_leave(manager_id, request_id)&lt;br&gt;reject_leave(manager_id, request_id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A63B62;strokeWidth=2;dashed=1;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="1190" y="775" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="p2_map2" value="&lt;b&gt;TOOL_FOR_INTENT — second mapping&lt;/b&gt;&lt;br&gt;apply / cancel / approve / reject only.&lt;br&gt;tool_for_intent() exposes it, but run_action does not use it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEAEA;strokeColor=#B33A3A;strokeWidth=2;dashed=1;fontColor=#8A1C1C;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="820" y="1015" width="670" height="105" as="geometry"/></mxCell>
        <mxCell id="p2_limits" value="&lt;b&gt;Centralized by dispatcher&lt;/b&gt;: tool existence • required argument presence • mutation boolean • exception containment&lt;br&gt;&lt;b&gt;Still decentralized&lt;/b&gt;: role checks • ownership • confirmation • structured schema validation • idempotency • response formatting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=2;fontColor=#6B4A00;fontSize=13;align=left;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="100" y="1030" width="650" height="105" as="geometry"/></mxCell>

        <mxCell id="p2_hcs_title" value="3  HCS-11 BOUNDARY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#17233F;strokeColor=#17233F;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="p2_1"><mxGeometry x="1600" y="135" width="1530" height="52" as="geometry"/></mxCell>
        <mxCell id="p2_upload" value="&lt;b&gt;DOCUMENT_UPLOAD graph node&lt;/b&gt;&lt;br&gt;Returns fixed text/action payload that opens UI&lt;br&gt;No document bytes enter the LLM or LangGraph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8EFFB;strokeColor=#2F5AA8;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="230" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_frontend" value="&lt;b&gt;Frontend upload window&lt;/b&gt;&lt;br&gt;Calls REST endpoints outside the chat graph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="2230" y="235" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="p2_api" value="&lt;b&gt;hcs11_documents.py FastAPI endpoints&lt;/b&gt;&lt;br&gt;Health • cases • active case • document upload/remove&lt;br&gt;Guarded by hcs11_enabled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="2710" y="225" width="370" height="110" as="geometry"/></mxCell>
        <mxCell id="p2_client" value="&lt;b&gt;HCS11Client → external HCS-11 backend&lt;/b&gt;&lt;br&gt;Async httpx • typed schemas • ID mapping • error translation&lt;br&gt;Document verification may take 30–60 seconds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A76500;strokeWidth=3;dashed=1;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="2230" y="425" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="p2_dead" value="&lt;b&gt;handle_school_verification.py is currently not in the graph&lt;/b&gt;&lt;br&gt;conversation_workflow and run_action do not import it.&lt;br&gt;Questions about education use normal RAG + the authorised education_plan field.&lt;br&gt;School document/status activity uses DOCUMENT_UPLOAD + the separate HCS-11 REST/UI flow." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEAEA;strokeColor=#B33A3A;strokeWidth=3;fontColor=#8A1C1C;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="640" width="1420" height="130" as="geometry"/></mxCell>

        <mxCell id="p2_state_title" value="4  CHECKPOINTED STATE AND OUTPUT SAFETY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#17233F;strokeColor=#17233F;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="p2_1"><mxGeometry x="1600" y="860" width="1530" height="52" as="geometry"/></mxCell>
        <mxCell id="p2_service" value="&lt;b&gt;answer_question_service&lt;/b&gt;&lt;br&gt;Versioned thread ID • reject cross-employee reuse&lt;br&gt;new-turn vs Command(resume=...) decision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8EFFB;strokeColor=#2F5AA8;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="975" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_sqlite" value="&lt;b&gt;SqliteSaver&lt;/b&gt;&lt;br&gt;conversation_checkpoints.sqlite • WAL&lt;br&gt;InMemorySaver fallback/tests" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F6F8FB;strokeColor=#6B4BA3;strokeWidth=3;fontColor=#17233F;fontSize=13;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="1160" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="p2_state" value="&lt;b&gt;ConversationState v6 — total=False TypedDict&lt;/b&gt;&lt;br&gt;Memory: remembered_turns, previous_reply&lt;br&gt;Identity: IDs, question, language, timer&lt;br&gt;Full employee_facts + employee_profile&lt;br&gt;Understanding + clarification&lt;br&gt;Subqueries, routing, evidence reducer&lt;br&gt;Draft, calculations, chart, validation&lt;br&gt;Final answer, citations, UI action payload&lt;br&gt;Leave draft, validation, stage and pause replies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#2F5AA8;strokeWidth=3;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="2160" y="975" width="460" height="305" as="geometry"/></mxCell>
        <mxCell id="p2_validation" value="&lt;b&gt;validate_answer — deterministic, first failure wins&lt;/b&gt;&lt;br&gt;1. evidence present&lt;br&gt;2. quantities grounded or declared from grounded inputs&lt;br&gt;3. no other EMP identifier or external email&lt;br&gt;4. requested language matches&lt;br&gt;&lt;br&gt;Valid → finalize; invalid → safe fallback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E7F4EC;strokeColor=#207A56;strokeWidth=3;fontColor=#17233F;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="2700" y="975" width="380" height="235" as="geometry"/></mxCell>
        <mxCell id="p2_persist" value="&lt;b&gt;Persistence reality&lt;/b&gt;&lt;br&gt;record_conversation_turn clears selected heavy evidence fields, stores memory and latency, but the completed checkpoint can still contain employee facts/profile, routing plans, checkable evidence, leave draft/validation and UI state. Most working fields are cleared only when the next turn begins." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCEAEA;strokeColor=#B33A3A;strokeWidth=2;fontColor=#8A1C1C;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="1370" width="1420" height="125" as="geometry"/></mxCell>
        <mxCell id="p2_validator_limits" value="&lt;b&gt;Validator does not explicitly verify&lt;/b&gt; citation presence • tool provenance • external API status • centralized role/ownership. Action/direct replies with no payload use approved fixed text itself as evidence; a separate test forbids quantities in those fixed messages." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2D9;strokeColor=#D79B00;strokeWidth=2;fontColor=#6B4A00;fontSize=13;align=left;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="1660" y="1555" width="1420" height="100" as="geometry"/></mxCell>

        <mxCell id="p2_summary" value="&lt;b&gt;DOCUMENTATION VERDICT&lt;/b&gt;&lt;br&gt;The top-level graph is stable for the four registered non-pausing leave actions and the leave application interrupt boundaries are sound. However, the implementation is not a single generic ToolNode architecture: it has an intent→handler registry plus a separate tool registry, direct database/service reads remain, HCS-11 is outside LangGraph, and one shared total=False state carries every concern." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#17233F;strokeColor=#17233F;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="p2_1"><mxGeometry x="100" y="1740" width="2980" height="125" as="geometry"/></mxCell>
        <mxCell id="p2_sources" value="&lt;b&gt;Source map&lt;/b&gt;  conversation_workflow.py • routing_rules.py • nodes/run_action.py • nodes/leave_application.py • nodes/handle_leave_action.py • workflow/tools/registry.py • workflow/tools/dispatcher.py • conversation_state.py • conversation_checkpointer.py • answer_validation.py • api/endpoints/hcs11_documents.py • integrations/hcs11_client.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6F8FB;strokeColor=#AEB8C7;fontColor=#334155;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="p2_1"><mxGeometry x="100" y="1910" width="2980" height="70" as="geometry"/></mxCell>

        <mxCell id="p2_e01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_understand" target="p2_decide"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e02" value="APPLY_LEAVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63B62;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_decide" target="p2_apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e03" value="ACTION_FOR_INTENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63B62;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_decide" target="p2_run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e04" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63B62;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_run" target="p2_map"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e05" value="handler(state)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_map" target="p2_handlers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e06" value="some reads + writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#207A56;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_handlers" target="p2_dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
