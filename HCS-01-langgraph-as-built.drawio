  <diagram id="runtime" name="The graph as it runs">
    <mxGraphModel dx="2400" dy="1500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="b_clar" style="rounded=0;fillColor=#FFF8E1;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="81" width="1710" height="116" as="geometry"/></mxCell>
        <mxCell id="b_clar_t" value="ASK ONE THING BACK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="83" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b_reph" style="rounded=0;fillColor=#EDE7F6;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="226" width="1710" height="126" as="geometry"/></mxCell>
        <mxCell id="b_reph_t" value="REWORD THE LAST REPLY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="228" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b_rag" style="rounded=0;fillColor=#E3F2FD;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="376" width="1710" height="126" as="geometry"/></mxCell>
        <mxCell id="b_rag_t" value="LOOK IT UP   (policy + own record)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="378" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b_lv" style="rounded=0;fillColor=#E8F5E9;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="551" width="1710" height="256" as="geometry"/></mxCell>
        <mxCell id="b_lv_t" value="APPLY FOR LEAVE   (three pauses)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="553" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b_act" style="rounded=0;fillColor=#FFF3E0;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="866" width="1710" height="122" as="geometry"/></mxCell>
        <mxCell id="b_act_t" value="DO SOMETHING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="868" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b_dir" style="rounded=0;fillColor=#ECEFF1;strokeColor=none;opacity=50;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="996" width="1710" height="241" as="geometry"/></mxCell>
        <mxCell id="b_dir_t" value="REPLY STRAIGHT AWAY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#5A6A78;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="1250" y="998" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;b&gt;HCS-01 — Dalīl&lt;/b&gt;&lt;br/&gt;the conversation graph, exactly as it runs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#16283A;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="400" height="74" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Grey arrow — always happens next&lt;br/&gt;Purple dashed — one road out of several&lt;br/&gt;Red dashed — the reply is refused&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Blue box&lt;/b&gt; — asks the language model&lt;br/&gt;&lt;b&gt;Yellow box&lt;/b&gt; — stops and waits for the employee&lt;br/&gt;&lt;b&gt;Red box&lt;/b&gt; — safety&lt;br/&gt;&lt;b&gt;White box&lt;/b&gt; — plain code, no model" style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;html=1;align=left;verticalAlign=top;spacing=10;dashed=1;fontSize=11;fontColor=#16283A;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="330" height="252" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;The one rule worth noticing&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every road on this page ends at &lt;b&gt;validate_answer&lt;/b&gt;. A greeting, a leave approval, a policy answer and a reworded reply all pass the same four checks before anyone sees them.&lt;br/&gt;&lt;br/&gt;Seven of these roads used to skip it." style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;html=1;align=left;verticalAlign=top;spacing=10;dashed=1;fontSize=11;fontColor=#16283A;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="330" height="196" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;START&lt;/b&gt;" style="rounded=1;arcSize=40;fillColor=#37474F;strokeColor=#263238;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="695" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="load_employee_facts" value="&lt;b&gt;load_employee_facts&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;the whole record, once per turn&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="685" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="understand_query" value="&lt;b&gt;understand_query&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;one intent from a closed list&lt;br/&gt;ask back?  reword?&lt;br/&gt;more than one question?&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="200" height="320" as="geometry"/></mxCell>
        <mxCell id="compose_clarification_question" value="&lt;b&gt;compose_clarification_question&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;one short question back&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="115" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="wait_for_clarification" value="&lt;b&gt;wait_for_clarification&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;PAUSE — waits for the reply&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFF2C4;strokeColor=#C08A00;fontColor=#5A4200;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="115" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="merge_clarification_into_question" value="&lt;b&gt;merge_clarification_into_question&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;reads both together · asks only once&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1730" y="115" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="rephrase_previous_answer" value="&lt;b&gt;rephrase_previous_answer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;same facts, said differently&lt;br/&gt;searches nothing&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="260" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="rewrite_and_decompose_query" value="&lt;b&gt;rewrite_and_decompose_query&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;“and sick leave?” → a full question&lt;br/&gt;splits into up to 5 parts&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="route_each_subquery" value="&lt;b&gt;route_each_subquery&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;per part: policy · record · both&lt;br/&gt;· cannot be answered&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="410" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="gather_subquery_evidence" value="&lt;b&gt;gather_subquery_evidence&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;one branch per part, all at once&lt;br/&gt;search + authorised record fields&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1730" y="410" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="assemble_evidence" value="&lt;b&gt;assemble_evidence&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;parts back in order&lt;br/&gt;citations merged&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2090" y="410" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="generate_answer" value="&lt;b&gt;generate_answer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;drafts from the evidence only&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2450" y="410" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="handle_leave_application" value="&lt;b&gt;handle_leave_application&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;reads it · checks it against policy&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="585" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="compose_leave_confirmation" value="&lt;b&gt;compose_leave_confirmation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;sends the confirmation card&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="585" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="wait_for_leave_confirmation" value="&lt;b&gt;wait_for_leave_confirmation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;PAUSE&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFF2C4;strokeColor=#C08A00;fontColor=#5A4200;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1730" y="585" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="submit_leave_application" value="&lt;b&gt;submit_leave_application&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;re-checks policy, then writes&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2090" y="585" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="request_leave_dates" value="&lt;b&gt;request_leave_dates&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;sends the calendar&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="725" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="wait_for_leave_dates" value="&lt;b&gt;wait_for_leave_dates&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;PAUSE&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFF2C4;strokeColor=#C08A00;fontColor=#5A4200;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1730" y="725" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="run_action" value="&lt;b&gt;run_action&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;cancel · my own status&lt;br/&gt;· approve · reject&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="900" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="generate_greeting" value="&lt;b&gt;generate_greeting&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;hello · what I can do · what we covered&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="1035" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="generate_document_upload_prompt" value="&lt;b&gt;generate_document_upload_prompt&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;opens the upload window&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="1155" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="prepare_action_answer" value="&lt;b&gt;prepare_action_answer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;hands the check the reply&lt;br/&gt;and the data behind it&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2450" y="1025" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="validate_answer" value="&lt;b&gt;validate_answer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;1 · is there evidence&lt;br/&gt;2 · is every figure grounded&lt;br/&gt;3 · nobody else’s record&lt;br/&gt;4 · the right language&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FBE0DC;strokeColor=#BF3B2B;fontColor=#6E2118;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="2810" y="645" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="finalize_verified_answer" value="&lt;b&gt;finalize_verified_answer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;tidies the text · builds citations&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#DFF3E6;strokeColor=#1E8449;fontColor=#12522F;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="3090" y="520" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="build_safe_fallback" value="&lt;b&gt;build_safe_fallback&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;out of scope · nothing found&lt;br/&gt;· a figure that was not grounded&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FBE0DC;strokeColor=#BF3B2B;fontColor=#6E2118;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="3090" y="1260" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="record_conversation_turn" value="&lt;b&gt;record_conversation_turn&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;remembers the turn&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="3370" y="660" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;END&lt;/b&gt;" style="rounded=1;arcSize=40;fillColor=#37474F;strokeColor=#263238;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="3650" y="675" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="start" target="load_employee_facts"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="720" as="sourcePoint"/><mxPoint x="200" y="720" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="load_employee_facts" target="understand_query"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="720" as="sourcePoint"/><mxPoint x="400" y="720" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.8;dashed=1;dashPattern=7 4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="understand_query" target="compose_clarification_question"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="579" as="sourcePoint"/><mxPoint x="1010" y="150" as="targetPoint"/><Array as="points"><mxPoint x="620" y="579"/><mxPoint x="620" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="f1_lbl" value="needs one thing cleared up" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontColor=#4A2E86;opacity=95;" vertex="1" parent="1"><mxGeometry x="630" y="269" width="155" height="19" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.8;dashed=1;dashPattern=7 4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="understand_query" target="rephrase_previous_answer"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="614" as="sourcePoint"/><mxPoint x="1010" y="300" as="targetPoint"/><Array as="points"><mxPoint x="638" y="614"/><mxPoint x="638" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="f2_lbl" value="“say that again, shorter”" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontColor=#4A2E86;opacity=95;" vertex="1" parent="1"><mxGeometry x="749" y="307" width="150" height="19" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.8;dashed=1;dashPattern=7 4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="understand_query" target="rewrite_and_decompose_query"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="650" as="sourcePoint"/><mxPoint x="1010" y="450" as="targetPoint"/><Array as="points"><mxPoint x="656" y="650"/><mxPoint x="656" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="f3_lbl" value="leans on the last turn, or asks two things" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontColor=#4A2E86;opacity=95;" vertex="1" parent="1"><mxGeometry x="712" y="424" width="243" height="19" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;strokeWidth=1.8;dashed=1;dashPattern=7 4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="understand_query" target="route_each_subquery"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="685" as="sourcePoint"/><mxPoint x="1475" y="490" as="targetPoint"/><Array as="points"><mxPoint x="674" y="685"/><mxPoint x="674" y="530"/><mxPoint x="1475" y="530"/></Array></mxGeometry></mxCell>
