  <diagram id="beneath" name="Everything it leans on">
    <mxGraphModel dx="2000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="h1" value="&lt;b&gt;1 · HOW AN ACTION ACTUALLY RUNS&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#5A6A78;fontSize=13;fontStyle=1;html=1;align=left;letterSpacing=1;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="600" height="44" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;understand_query&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;one intent, from a closed list of eleven&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#E3EDFB;strokeColor=#2E6BB8;fontColor=#0E2E5C;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;decide_after_understanding&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;the only fork · clarification capped at one round&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;APPLY_LEAVE has its own sub-flow  ·  everything else goes to run_action&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;applying is the only action that pauses, so it needs steps of its own to pause in&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;ACTION_FOR_INTENT  —  a plain dict of four handlers&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;cancel → handle_leave_cancellation · status → handle_leave_status&lt;br/&gt;approve, reject → handle_manager_approval  ·  no schooling intent here&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="544" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;the handler functions&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;each does its own parsing, its own scoped lookup,&lt;br/&gt;its own authorisation and its own wording&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="678" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;run_tool(name, authorised_to_write=False, **args)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;the single door to anything that changes a record&lt;br/&gt;refuses by default · unknown_tool · missing_arguments&lt;br/&gt;· not_authorised · the_action_failed · declined&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FBE0DC;strokeColor=#BF3B2B;fontColor=#6E2118;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="600" height="92" as="geometry"/></mxCell>
        <mxCell id="a7" value="&lt;b&gt;eight tools — four read, four write&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;read: check_leave_status · list_pending_approvals&lt;br/&gt;get_education_entitlement · check_leave_against_policy&lt;br/&gt;write: apply_for_leave · cancel_leave · approve_leave · reject_leave&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="954" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;2 · WHERE HCS-11 IS TOUCHED   (read and write, both ways out)&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#5A6A78;fontSize=13;fontStyle=1;html=1;align=left;letterSpacing=1;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="640" height="44" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;A · sending documents in&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;fontColor=#3B4A57;fontSize=10;html=1;dashed=1;spacing=8;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;B · asking where a claim stands&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;fontColor=#3B4A57;fontSize=10;html=1;dashed=1;spacing=8;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;generate_document_upload_prompt&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;opens the upload window&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="274" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;gather_subquery_evidence&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;school_claim_status was authorised&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1140" y="274" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;the browser’s upload window&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;the employee picks the files&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="388" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;read_school_claims()&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;sync · 8s timeout · fails closed&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1140" y="388" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;hcs11_documents.py&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;REST · upload · remove · cases&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="502" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;one GET /api/hcs11/cases&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;the same call the window makes&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1140" y="502" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;HCS-11 — the school verification service&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;its own app, its own database, on its own port&lt;br/&gt;documents are written by A  ·  B only ever reads&lt;br/&gt;unreachable is reported as unknown, never as “you have no claim”&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#DFF3E6;strokeColor=#1E8449;fontColor=#12522F;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="640" height="96" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;No document bytes reach the language model, and no HCS-11 table is read directly. Everything crosses on its published API.&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;fontColor=#3B4A57;fontSize=10;html=1;dashed=1;spacing=8;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="750" width="640" height="84" as="geometry"/></mxCell>
        <mxCell id="h3" value="&lt;b&gt;3 · WHAT KEEPS AN ANSWER HONEST&lt;/b&gt;" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#5A6A78;fontSize=13;fontStyle=1;html=1;align=left;letterSpacing=1;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="1560" y="120" width="600" height="44" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;answer_question_service&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;thread id carries the state version · another employee’s thread is refused&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="600" height="76" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;SqliteSaver&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;conversation_checkpoints.sqlite · in-memory in tests&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="300" width="600" height="76" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;ConversationState  v6&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;what survives a pause: the turn, the memory, the draft, the leave request&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="410" width="600" height="76" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;validate_answer  —  four checks, first failure wins&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;1 · there is evidence behind it&lt;br/&gt;2 · every figure is in that evidence, or worked out from it&lt;br/&gt;3 · no other employee’s id and no outside email&lt;br/&gt;4 · the language that was asked for&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FBE0DC;strokeColor=#BF3B2B;fontColor=#6E2118;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="520" width="600" height="112" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;HrDataField — the only facts that may be read&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px;color:#54687A'&gt;annual_leave_balance · sick_leave_balance · carry_over_days&lt;br/&gt;line_manager · manager_history · probation_status&lt;br/&gt;years_of_service · recent_leave_requests · recent_expense_claims&lt;br/&gt;employee_profile · education_plan · school_claim_status&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#5B7C99;fontColor=#16283A;fontSize=11;html=1;spacing=4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="666" width="600" height="128" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Anything the model asks for that is not on that list is dropped before the record is read.&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#FAFBFC;strokeColor=#C3CDD6;fontColor=#3B4A57;fontSize=10;html=1;dashed=1;spacing=8;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="1560" y="828" width="600" height="76" as="geometry"/></mxCell>
        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="260" as="sourcePoint"/><mxPoint x="380" y="300" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="370" as="sourcePoint"/><mxPoint x="380" y="410" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="494" as="sourcePoint"/><mxPoint x="380" y="544" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="628" as="sourcePoint"/><mxPoint x="380" y="678" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="762" as="sourcePoint"/><mxPoint x="380" y="812" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="904" as="sourcePoint"/><mxPoint x="380" y="954" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="350" as="sourcePoint"/><mxPoint x="950" y="388" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="464" as="sourcePoint"/><mxPoint x="950" y="502" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="q3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BF3B2B;strokeWidth=1.8;dashed=1;dashPattern=7 4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="578" as="sourcePoint"/><mxPoint x="950" y="620" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="350" as="sourcePoint"/><mxPoint x="1290" y="388" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
