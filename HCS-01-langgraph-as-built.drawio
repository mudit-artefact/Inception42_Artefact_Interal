        <mxCell id="q6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7C99;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="578" as="sourcePoint"/><mxPoint x="1290" y="620" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
