        <mxCell id="subtitle" value="Generated from the running graph and checked against it. Every branch that answers without searching joins the same check — seven of them used to reach the employee without it. Actions sit behind one branch and a registry; applying for leave keeps its own steps because it is the only action that pauses to ask." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5A6E;fontSize=13;" vertex="1" parent="1">
