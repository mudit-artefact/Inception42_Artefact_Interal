        <mxCell id="assemble_evidence" value="assemble_evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="520" y="920" width="160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-gather0-assemble" value="" style="endArrow=classic;html=1;strokeColor=#0284c7;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" parent="1" source="gather_evidence_0" target="assemble_evidence" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-gathern-assemble" value="" style="endArrow=classic;html=1;strokeColor=#0284c7;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" parent="1" source="gather_evidence_n" target="assemble_evidence" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-wait-all" value="wait for all" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#0284c7;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="605" y="890" width="60" height="16" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- GENERATE ANSWER -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="generate_answer" value="generate_answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="525" y="990" width="150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-assemble-generate" value="" style="endArrow=classic;html=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="assemble_evidence" target="generate_answer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- VALIDATE ANSWER -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="validate_answer" value="validate_answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="525" y="1060" width="150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-generate-validate" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="generate_answer" target="validate_answer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rephrase connects directly to validate -->
        <mxCell id="edge-rephrase-validate" value="" style="endArrow=classic;html=1;strokeColor=#db2777;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.5;curved=1;" parent="1" source="rephrase_previous_answer" target="validate_answer" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="335" y="700" />
              <mxPoint x="335" y="1078" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-skip-search" value="skip evidence gathering" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#db2777;fontStyle=1;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="260" y="750" width="130" height="16" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- DECISION: VALID? -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="decision-valid" value="valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="1130" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-validate-decision" value="" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="validate_answer" target="decision-valid" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- FINALIZE VERIFIED ANSWER -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="finalize_verified_answer" value="finalize_verified_answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="500" y="1230" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-decision-finalize" value="" style="endArrow=classic;html=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="decision-valid" target="finalize_verified_answer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-yes" value="yes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#059669;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="570" y="1200" width="30" height="16" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- BUILD SAFE FALLBACK -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="build_safe_fallback" value="build_safe_fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="970" y="1150" width="160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-decision-fallback" value="" style="endArrow=classic;html=1;strokeColor=#dc2626;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="decision-valid" target="build_safe_fallback" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-no" value="no" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#dc2626;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="750" y="1148" width="30" height="16" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- RECORD CONVERSATION TURN -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="record_conversation_turn" value="record_conversation_turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#f8fafc;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="505" y="1320" width="190" height="36" as="geometry" />
        </mxCell>

        <!-- From finalize -->
        <mxCell id="edge-finalize-record" value="" style="endArrow=classic;html=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="finalize_verified_answer" target="record_conversation_turn" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- From fallback -->
        <mxCell id="edge-fallback-record" value="" style="endArrow=classic;html=1;strokeColor=#dc2626;strokeWidth=2;exitX=0.5;exitY=1;entryX=1;entryY=0.5;curved=1;" parent="1" source="build_safe_fallback" target="record_conversation_turn" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="1280" />
              <mxPoint x="800" y="1338" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- From greeting -->
        <mxCell id="edge-greeting-record" value="" style="endArrow=classic;html=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.5;curved=1;" parent="1" source="generate_greeting" target="record_conversation_turn" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="500" />
              <mxPoint x="200" y="1000" />
              <mxPoint x="200" y="1338" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- END NODE -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <mxCell id="end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#64748b;strokeColor=#475569;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="540" y="1390" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-record-end" value="" style="endArrow=classic;html=1;strokeColor=#64748b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="record_conversation_turn" target="end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
